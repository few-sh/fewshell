{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "decamp-agent (server)",
            "cwd": "decamp-agent",
            "request": "launch",
            "type": "dart",
            "program": "bin/server.dart",
            "args": ["--port", "3123"]
        },
        {
            "name": "decamp-app",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "decamp-app (macOS)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos"
        },
        {
            "name": "decamp-app (profile mode)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "decamp-app (release mode)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (Server + App)",
            "configurations": ["decamp-agent (server)", "decamp-app"]
        },
        {
        "name": "Full Stack Plus Mac(Server + App)",
            "configurations": ["decamp-agent (server)", "decamp-app", "decamp-app (macOS)"]
        }
    ]
}