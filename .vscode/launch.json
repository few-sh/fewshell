    "version": "0.2.0",
    "configurations": [
        {
            "name": "decamp-agent (server)",
            "cwd": "decamp-agent",
            "request": "launch",
            "type": "dart",
            "program": "bin/server.dart",
            "args": ["--port", "3123"],
            "env": {
                "PUSH_NOTIFICATION_URL": "http://localhost:8080",
                "PUSH_NOTIFICATION_API_KEY": "test-api-key",
            }
        },
        {
            "name": "decamp-app",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "decamp-app (macOS)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos"
        },
        {
            "name": "decamp-app (profile mode)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "decamp-app (release mode)",
            "cwd": "decamp-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "decamp-agent (server, public relay)",
            "cwd": "decamp-agent",
            "request": "launch",
            "type": "dart",
            "program": "bin/server.dart",
            "args": ["--port", "3123"],
            "env": {
                "PUSH_NOTIFICATION_URL": "https://fewshell-relay-734417761966.us-central1.run.app/",
                "PUSH_NOTIFICATION_API_KEY": "ArdmtfC0UM5fdAZEyNrtG4Ws41GfPnIxKSKfSAiOdPM=",
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (Server + App)",
            "configurations": ["decamp-agent (server)", "decamp-app"]
        },
        {
        "name": "Full Stack Plus Mac(Server + App)",
            "configurations": ["decamp-agent (server)", "decamp-app", "decamp-app (macOS)"]
        }
    ]
}