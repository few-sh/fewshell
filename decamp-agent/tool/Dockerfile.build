FROM ubuntu:22.04

# Install necessary dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    libsqlite3-dev \
    build-essential \
    cmake \
    ninja-build \
    clang \
    && rm -rf /var/lib/apt/lists/*

# Set up Flutter/Dart
ENV FLUTTER_ROOT=/sdk/flutter
ENV PATH="${FLUTTER_ROOT}/bin:${PATH}"

# Download and install Flutter
RUN git clone https://github.com/flutter/flutter.git -b 3.32.4 --depth 1 $FLUTTER_ROOT

# Configure git to be safe for the /app mount (fixes potential ownership issues in dev)
RUN git config --global --add safe.directory '*'

# Pre-download Dart SDK and artifacts
RUN flutter precache

# Set working directory to where we expect the project to be mounted
WORKDIR /app/decamp-agent
